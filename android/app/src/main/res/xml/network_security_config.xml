<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything the app talks to is on 127.0.0.1. Android has blocked cleartext
  HTTP by default since API 28, and it makes no exception for loopback, so the
  local server has to be allowed here explicitly — and only the local server.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
