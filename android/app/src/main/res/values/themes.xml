<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Viewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorOnPrimary">@color/void_bg</item>
        <item name="colorSecondary">@color/cyan_dim</item>
        <item name="colorOnSecondary">@color/void_bg</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/dim</item>
        <item name="colorOutline">@color/line_hi</item>
        <item name="android:colorBackground">@color/void_bg</item>
        <item name="android:windowBackground">@color/void_bg</item>
        <item name="android:statusBarColor">@color/void_bg</item>
        <item name="android:navigationBarColor">@color/void_bg</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/dim</item>
    </style>

    <!-- The player draws edge to edge, behind the notch, with no system bars. -->
    <style name="Theme.Viewer.Player" parent="Theme.Viewer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!--
      Names deliberately carry no dots. A dotted style name implies an inherited
      parent of that name (`Viewer.SectionTitle` would look for a style called
      `Viewer`), which is a trap when these are plain standalone text styles.
    -->
    <style name="ViewerSectionTitle">
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ViewerHint">
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="ViewerTitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ViewerMono">
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
